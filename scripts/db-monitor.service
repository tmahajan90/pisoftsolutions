[Unit]
Description=Database Monitor and Auto-Recovery Service
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/Users/tarun/rails_apps/pisoftsolutions
ExecStart=/Users/tarun/rails_apps/pisoftsolutions/scripts/db_monitor.sh monitor
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Resource limits
LimitNOFILE=65536
LimitNPROC=32768

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/Users/tarun/rails_apps/pisoftsolutions

[Install]
WantedBy=multi-user.target
