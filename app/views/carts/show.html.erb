<!-- Cart Header -->
<section class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h1 class="text-4xl font-bold mb-4">Shopping Cart</h1>
      <p class="text-xl opacity-90">Review your items and proceed to checkout</p>
    </div>
  </div>
</section>

<!-- Cart Content -->
<section class="py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if @cart_items.any? %>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Cart Items -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-lg shadow-lg p-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Cart Items (<%= @cart.total_items %>)</h2>
            
            <div class="space-y-6">
              <% @cart_items.each do |cart_item| %>
                <div class="cart-item flex items-center space-x-4 p-4 border border-gray-200 rounded-lg" 
                     data-product-id="<%= cart_item.product.id %>"
                     data-validity-type="<%= cart_item.validity_type %>"
                     data-validity-duration="<%= cart_item.validity_duration %>"
                     data-validity-price="<%= cart_item.validity_price %>">
                  <!-- Product Image -->
                  <div class="w-20 h-20 bg-gradient-to-br from-<%= cart_item.product.color %>-500 to-<%= cart_item.product.color %>-600 rounded-lg flex items-center justify-center">
                    <i class="<%= product_icon(cart_item.product) %> text-3xl text-white"></i>
                  </div>
                  
                  <!-- Product Details -->
                  <div class="flex-1">
                    <h3 class="text-lg font-semibold text-gray-900"><%= cart_item.product.name %></h3>
                    <p class="text-sm text-gray-600"><%= cart_item.product.description %></p>
                    <div class="flex items-center mt-2">
                      <span class="text-lg font-bold text-<%= cart_item.product.color %>-600">₹<%= cart_item.validity_price || cart_item.product.default_validity_option&.price || 0 %></span>
                      <% 
                        if cart_item.validity_price.blank?
                          default_option = cart_item.product.default_validity_option || cart_item.product.validity_options.first
                          if default_option && default_option.has_discount? %>
                            <span class="text-sm text-gray-500 line-through ml-2">₹<%= default_option.original_price %></span>
                            <span class="text-sm text-green-600 font-semibold ml-2">Save ₹<%= default_option.savings_amount %></span>
                          <% end
                        end %>
                      <% if cart_item.validity_type.present? %>
                        <span class="text-xs text-gray-500 ml-2">(<%= cart_item.validity_display %>)</span>
                      <% end %>
                    </div>
                  </div>
                  
                  <!-- Quantity Controls -->
                  <div class="flex items-center space-x-2">
                    <button class="quantity-btn w-8 h-8 bg-gray-100 hover:bg-gray-200 rounded-full flex items-center justify-center transition duration-200 cursor-pointer <%= 'opacity-50 cursor-not-allowed' if cart_item.quantity <= 1 %>" 
                            data-product-id="<%= cart_item.product.id %>" 
                            data-validity-type="<%= cart_item.validity_type %>"
                            data-validity-duration="<%= cart_item.validity_duration %>"
                            data-validity-price="<%= cart_item.validity_price %>"
                            data-change="-1" 
                            <%= 'disabled' if cart_item.quantity <= 1 %>>
                      <i class="fas fa-minus text-gray-600"></i>
                    </button>
                    <span class="w-12 text-center font-semibold quantity-display"><%= cart_item.quantity %></span>
                    <button class="quantity-btn w-8 h-8 bg-gray-100 hover:bg-gray-200 rounded-full flex items-center justify-center transition duration-200 cursor-pointer" 
                            data-product-id="<%= cart_item.product.id %>" 
                            data-validity-type="<%= cart_item.validity_type %>"
                            data-validity-duration="<%= cart_item.validity_duration %>"
                            data-validity-price="<%= cart_item.validity_price %>"
                            data-change="1">
                      <i class="fas fa-plus text-gray-600"></i>
                    </button>
                  </div>
                  
                  <!-- Remove Button -->
                  <button class="remove-item-btn text-red-500 hover:text-red-700 transition duration-200 cursor-pointer" 
                          data-product-id="<%= cart_item.product.id %>"
                          data-validity-type="<%= cart_item.validity_type %>"
                          data-validity-duration="<%= cart_item.validity_duration %>"
                          data-validity-price="<%= cart_item.validity_price %>">
                    <i class="fas fa-trash text-lg"></i>
                  </button>
                </div>
              <% end %>
            </div>
            
            <!-- Clear Cart Button -->
            <div class="mt-6 pt-6 border-t border-gray-200">
              <button class="clear-cart-btn text-red-600 hover:text-red-800 font-semibold transition duration-200 cursor-pointer">
                <i class="fas fa-trash mr-2"></i>Clear Cart
              </button>
            </div>
          </div>
        </div>
        
        <!-- Order Summary -->
        <div class="lg:col-span-1">
          <div class="bg-white rounded-lg shadow-lg p-6 sticky top-4">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Order Summary</h2>
            
            <div class="space-y-4">
              <div class="flex justify-between">
                <span class="text-gray-600">Subtotal (<%= @cart.total_items %> items)</span>
                <span class="font-semibold order-summary-subtotal">₹<%= @cart.total_amount %></span>
              </div>
              
              <% 
                # Calculate total discount
                total_discount = 0
                total_original_amount = 0
                discount_items = []
                
                @cart_items.each do |cart_item|
                  # Find the validity option for this cart item
                  validity_option = nil
                  
                  if cart_item.validity_price.present?
                    # Cart item has custom validity price, find matching validity option
                    validity_option = cart_item.product.validity_options.find do |option|
                      option.duration_type == cart_item.validity_type && 
                      option.duration_value == cart_item.validity_duration
                    end
                  else
                    # Use default validity option
                    validity_option = cart_item.product.default_validity_option || cart_item.product.validity_options.first
                  end
                  
                  # Calculate discount if validity option has discount
                  if validity_option && validity_option.has_discount?
                    item_discount = validity_option.savings_amount * cart_item.quantity
                    item_original = validity_option.original_price * cart_item.quantity
                    total_discount += item_discount
                    total_original_amount += item_original
                    discount_items << {
                      product: cart_item.product.name,
                      validity: validity_option.label,
                      quantity: cart_item.quantity,
                      discount: item_discount,
                      original: item_original
                    }
                  end
                end
              %>
              
              <% if total_discount > 0 %>
                <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                  <div class="flex justify-between items-center mb-2">
                    <span class="text-green-800 font-semibold">Total Discount</span>
                    <span class="text-green-800 font-bold">-₹<%= total_discount.to_i %></span>
                  </div>
                  <div class="text-xs text-green-700">
                    <% discount_items.each do |item| %>
                      <div class="flex justify-between">
                        <span><%= item[:product] %> (<%= item[:validity] %>) × <%= item[:quantity] %></span>
                        <span>-₹<%= item[:discount].to_i %></span>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
              
              <div class="flex justify-between">
                <span class="text-gray-600">Tax</span>
                <span class="font-semibold">₹0.00</span>
              </div>
              
              <div class="flex justify-between">
                <span class="text-gray-600">Shipping</span>
                <span class="font-semibold text-green-600">FREE</span>
              </div>
              
              <div class="border-t border-gray-200 pt-4">
                <% if total_discount > 0 %>
                  <div class="flex justify-between text-sm text-gray-500 mb-2">
                    <span>Original Total</span>
                    <span class="line-through">₹<%= total_original_amount.to_i %></span>
                  </div>
                <% end %>
                <div class="flex justify-between">
                  <span class="text-xl font-bold text-gray-900">Total</span>
                  <span class="text-xl font-bold text-indigo-600 order-summary-total">₹<%= @cart.total_amount %></span>
                </div>
                <% if total_discount > 0 %>
                  <div class="text-sm text-green-600 font-semibold text-right mt-1">
                    You save ₹<%= total_discount.to_i %>!
                  </div>
                <% end %>
              </div>
            </div>
            
            <!-- Checkout Button -->
            <div class="mt-6">
              <%= link_to checkout_path, class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white py-3 px-6 rounded-lg font-semibold text-center block transition duration-300 cursor-pointer" do %>
                <i class="fas fa-credit-card mr-2"></i>Proceed to Checkout
              <% end %>
            </div>
            
            <!-- Continue Shopping -->
            <div class="mt-4">
              <%= link_to products_path, class: "w-full border border-indigo-600 text-indigo-600 hover:bg-indigo-50 py-3 px-6 rounded-lg font-semibold text-center block transition duration-300 cursor-pointer" do %>
                <i class="fas fa-arrow-left mr-2"></i>Continue Shopping
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% else %>
      <!-- Empty Cart -->
      <div class="text-center py-12">
        <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
          <i class="fas fa-shopping-cart text-3xl text-gray-400"></i>
        </div>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Your cart is empty</h2>
        <p class="text-gray-600 mb-8">Looks like you haven't added any products to your cart yet.</p>
        <%= link_to products_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-3 rounded-lg font-semibold transition duration-300 cursor-pointer" do %>
          <i class="fas fa-shopping-bag mr-2"></i>Start Shopping
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<script>
// Test script to verify JavaScript is working
console.log('Cart page loaded successfully');
document.addEventListener('DOMContentLoaded', function() {
  console.log('Cart page DOM ready');
});
</script>


