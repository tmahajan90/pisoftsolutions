<!-- Email Header -->
<div style="background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%); padding: 30px 20px; text-align: center;">
  <div style="max-width: 500px; margin: 0 auto;">
    <h1 style="color: #ffffff; font-size: 28px; font-weight: bold; margin: 0 0 10px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
      🛒 New Order Received
    </h1>
    <p style="color: #ffffff; font-size: 16px; margin: 0; opacity: 0.9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
      A new order has been placed on PiSoftSolutions
    </p>
  </div>
</div>

<!-- Main Content -->
<div style="padding: 30px 20px; background-color: #ffffff;">
  <div style="max-width: 500px; margin: 0 auto;">
    
    <!-- Alert -->
    <div style="background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 20px; margin-bottom: 25px;">
      <div style="display: flex; align-items: center; margin-bottom: 10px;">
        <span style="background-color: #dc2626; color: white; border-radius: 50%; width: 24px; height: 24px; display: inline-flex; align-items: center; justify-content: center; font-size: 14px; margin-right: 10px;">!</span>
        <h3 style="color: #dc2626; font-size: 16px; font-weight: 600; margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
          New Order Alert
        </h3>
      </div>
      <p style="color: #7f1d1d; font-size: 14px; margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        A new order has been placed and requires your attention.
      </p>
    </div>

    <!-- Order Summary -->
    <div style="background-color: #f8fafc; border-radius: 8px; padding: 25px; margin-bottom: 25px; border: 1px solid #e2e8f0;">
      <h3 style="color: #1e293b; font-size: 18px; font-weight: 600; margin: 0 0 20px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        Order Summary
      </h3>
      <div style="color: #475569; font-size: 14px; line-height: 1.8; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        <div style="margin-bottom: 12px;">
          <strong style="color: #1e293b;">Order ID:</strong> #<%= @order.id %>
        </div>
        <div style="margin-bottom: 12px;">
          <strong style="color: #1e293b;">Customer:</strong> <%= @user&.name || 'Guest' %>
        </div>
        <div style="margin-bottom: 12px;">
          <strong style="color: #1e293b;">Email:</strong> 
          <a href="mailto:<%= @order.user_email %>" style="color: #059669; text-decoration: none;"><%= @order.user_email %></a>
        </div>
        <% if @user&.phone.present? %>
        <div style="margin-bottom: 12px;">
          <strong style="color: #1e293b;">Phone:</strong> 
          <a href="tel:<%= @user.phone %>" style="color: #059669; text-decoration: none;"><%= @user.phone %></a>
        </div>
        <% end %>
        <div style="margin-bottom: 12px;">
          <strong style="color: #1e293b;">Order Date:</strong> <%= @order_date %> at <%= @order_time %>
        </div>
        <div style="margin-bottom: 12px;">
          <strong style="color: #1e293b;">Status:</strong> 
          <span style="color: #f59e0b; font-weight: 600;"><%= @order.status.titleize %></span>
        </div>
        <div style="margin-bottom: 12px;">
          <strong style="color: #1e293b;">Payment Status:</strong> 
          <span style="color: #f59e0b; font-weight: 600;"><%= @order.payment_status&.titleize || 'Pending' %></span>
        </div>
        <div style="margin-bottom: 12px;">
          <strong style="color: #1e293b;">Total Amount:</strong> 
          <span style="color: #059669; font-weight: 600; font-size: 16px;">₹<%= @order.total_amount %></span>
        </div>
      </div>
    </div>

    <!-- Order Items -->
    <div style="margin-bottom: 25px;">
      <h3 style="color: #1e293b; font-size: 18px; font-weight: 600; margin: 0 0 20px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        Order Items (<%= @order_items.count %>)
      </h3>
      <div style="border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden;">
        <% @order_items.each do |item| %>
        <div style="padding: 15px; border-bottom: 1px solid #e5e7eb; background-color: #ffffff;">
          <div style="display: flex; justify-content: space-between; align-items: start;">
            <div style="flex: 1;">
              <h4 style="color: #1e293b; font-size: 14px; font-weight: 600; margin: 0 0 5px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                <%= item.product.name %>
              </h4>
              <p style="color: #64748b; font-size: 12px; margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                Qty: <%= item.quantity %> | 
                <% if item.validity_type.present? %><%= item.validity_type.titleize %> - <%= item.validity_duration %> days | <% end %>
                ₹<%= item.price %> each
              </p>
            </div>
            <div style="text-align: right;">
              <p style="color: #1e293b; font-size: 14px; font-weight: 600; margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                ₹<%= item.subtotal %>
              </p>
            </div>
          </div>
        </div>
        <% end %>
      </div>
    </div>

    <!-- Applied Offers -->
    <% if @applied_offers.any? %>
    <div style="margin-bottom: 25px;">
      <h3 style="color: #1e293b; font-size: 16px; font-weight: 600; margin: 0 0 15px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        Applied Offers
      </h3>
      <div style="background-color: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 15px;">
        <% @applied_offers.each do |offer| %>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span style="color: #166534; font-size: 14px; font-weight: 500; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
            <%= offer.name %>
          </span>
          <span style="color: #166534; font-size: 14px; font-weight: 600; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
            -₹<%= offer.order_offers.find_by(order: @order).discount_amount %>
          </span>
        </div>
        <% end %>
      </div>
    </div>
    <% end %>

    <!-- Financial Summary -->
    <div style="background-color: #f1f5f9; border-radius: 8px; padding: 20px; margin-bottom: 25px;">
      <h4 style="color: #1e293b; font-size: 16px; font-weight: 600; margin: 0 0 15px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        Financial Summary
      </h4>
      <div style="color: #475569; font-size: 14px; line-height: 1.8; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
          <span>Subtotal:</span>
          <span>₹<%= @order.subtotal %></span>
        </div>
        <% if @order.total_discount > 0 %>
        <div style="display: flex; justify-content: space-between; margin-bottom: 8px; color: #059669;">
          <span>Discount:</span>
          <span>-₹<%= @order.total_discount %></span>
        </div>
        <% end %>
        <div style="display: flex; justify-content: space-between; padding-top: 8px; border-top: 1px solid #cbd5e1; font-weight: 600; color: #1e293b;">
          <span>Total Amount:</span>
          <span>₹<%= @order.total_amount %></span>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div style="margin-bottom: 25px;">
      <h3 style="color: #1e293b; font-size: 16px; font-weight: 600; margin: 0 0 15px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        Quick Actions
      </h3>
      <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <a href="<%= admin_order_url(@order) if defined?(admin_order_url) %>" style="display: inline-block; background-color: #059669; color: #ffffff; text-decoration: none; padding: 10px 20px; border-radius: 6px; font-weight: 500; font-size: 14px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
          View Order Details
        </a>
        <a href="<%= admin_orders_url if defined?(admin_orders_url) %>" style="display: inline-block; background-color: #6b7280; color: #ffffff; text-decoration: none; padding: 10px 20px; border-radius: 6px; font-weight: 500; font-size: 14px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
          All Orders
        </a>
      </div>
    </div>

    <!-- Statistics -->
    <div style="background-color: #f1f5f9; border-radius: 8px; padding: 20px; text-align: center;">
      <h4 style="color: #1e293b; font-size: 14px; font-weight: 600; margin: 0 0 10px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        Today's Statistics
      </h4>
      <p style="color: #64748b; font-size: 12px; margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        Total orders today: <%= Order.where(created_at: Date.current.beginning_of_day..Date.current.end_of_day).count %> | 
        Total revenue today: ₹<%= Order.where(created_at: Date.current.beginning_of_day..Date.current.end_of_day).sum(:total_amount) %>
      </p>
    </div>

  </div>
</div>

<!-- Footer -->
<div style="background-color: #1f2937; padding: 20px; text-align: center;">
  <div style="max-width: 500px; margin: 0 auto;">
    <p style="color: #9ca3af; font-size: 12px; margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
      This is an automated notification from PiSoftSolutions Admin Panel.
    </p>
  </div>
</div>
