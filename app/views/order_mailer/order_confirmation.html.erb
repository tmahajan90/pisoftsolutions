<!-- Email Header -->
<div style="background: linear-gradient(135deg, #059669 0%, #10b981 100%); padding: 40px 20px; text-align: center;">
  <div style="max-width: 500px; margin: 0 auto;">
    <h1 style="color: #ffffff; font-size: 32px; font-weight: bold; margin: 0 0 10px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
      Order Confirmed! 🎉
    </h1>
    <p style="color: #ffffff; font-size: 18px; margin: 0; opacity: 0.9; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
      Thank you for your order
    </p>
  </div>
</div>

<!-- Main Content -->
<div style="padding: 40px 20px; background-color: #ffffff;">
  <div style="max-width: 500px; margin: 0 auto;">
    
    <!-- Greeting -->
    <div style="margin-bottom: 30px;">
      <h2 style="color: #1f2937; font-size: 24px; font-weight: 600; margin: 0 0 15px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        Hello <%= @user&.name || 'Customer' %>!
      </h2>
      <p style="color: #6b7280; font-size: 16px; line-height: 1.6; margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        We've received your order and are processing it. You'll receive another email once your payment is confirmed.
      </p>
    </div>

    <!-- Order Details -->
    <div style="background-color: #f9fafb; border-radius: 8px; padding: 25px; margin-bottom: 30px; border-left: 4px solid #10b981;">
      <h3 style="color: #1f2937; font-size: 18px; font-weight: 600; margin: 0 0 15px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        Order Details
      </h3>
      <div style="color: #4b5563; font-size: 14px; line-height: 1.8; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        <p style="margin: 5px 0;"><strong>Order Number:</strong> #<%= @order.id %></p>
        <p style="margin: 5px 0;"><strong>Order Date:</strong> <%= @order_date %> at <%= @order_time %></p>
        <p style="margin: 5px 0;"><strong>Customer Email:</strong> <%= @order.user_email %></p>
        <p style="margin: 5px 0;"><strong>Status:</strong> <span style="color: #f59e0b; font-weight: 600;"><%= @order.status.titleize %></span></p>
        <p style="margin: 5px 0;"><strong>Payment Status:</strong> <span style="color: #f59e0b; font-weight: 600;"><%= @order.payment_status&.titleize || 'Pending' %></span></p>
      </div>
    </div>

    <!-- Order Items -->
    <div style="margin-bottom: 30px;">
      <h3 style="color: #1f2937; font-size: 18px; font-weight: 600; margin: 0 0 20px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        Order Items
      </h3>
      <div style="border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden;">
        <% @order_items.each do |item| %>
        <div style="padding: 20px; border-bottom: 1px solid #e5e7eb; background-color: #ffffff;">
          <div style="display: flex; justify-content: space-between; align-items: start;">
            <div style="flex: 1;">
              <h4 style="color: #1f2937; font-size: 16px; font-weight: 600; margin: 0 0 8px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                <%= item.product.name %>
              </h4>
              <p style="color: #6b7280; font-size: 14px; margin: 0 0 5px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                Quantity: <%= item.quantity %>
              </p>
              <% if item.validity_type.present? %>
              <p style="color: #6b7280; font-size: 14px; margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                Validity: <%= item.validity_type.titleize %> - <%= item.validity_duration %> days
              </p>
              <% end %>
            </div>
            <div style="text-align: right;">
              <p style="color: #1f2937; font-size: 16px; font-weight: 600; margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
                ₹<%= item.subtotal %>
              </p>
            </div>
          </div>
        </div>
        <% end %>
      </div>
    </div>

    <!-- Applied Offers -->
    <% if @applied_offers.any? %>
    <div style="margin-bottom: 30px;">
      <h3 style="color: #1f2937; font-size: 18px; font-weight: 600; margin: 0 0 15px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        Applied Offers
      </h3>
      <div style="background-color: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 15px;">
        <% @applied_offers.each do |offer| %>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span style="color: #166534; font-size: 14px; font-weight: 500; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
            <%= offer.name %>
          </span>
          <span style="color: #166534; font-size: 14px; font-weight: 600; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
            -₹<%= offer.order_offers.find_by(order: @order).discount_amount %>
          </span>
        </div>
        <% end %>
      </div>
    </div>
    <% end %>

    <!-- Order Summary -->
    <div style="background-color: #f8fafc; border-radius: 8px; padding: 25px; margin-bottom: 30px;">
      <h3 style="color: #1f2937; font-size: 18px; font-weight: 600; margin: 0 0 20px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        Order Summary
      </h3>
      <div style="color: #4b5563; font-size: 14px; line-height: 1.8; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
          <span>Subtotal:</span>
          <span>₹<%= @order.subtotal %></span>
        </div>
        <% if @order.total_discount > 0 %>
        <div style="display: flex; justify-content: space-between; margin-bottom: 10px; color: #059669;">
          <span>Discount:</span>
          <span>-₹<%= @order.total_discount %></span>
        </div>
        <% end %>
        <div style="display: flex; justify-content: space-between; padding-top: 10px; border-top: 1px solid #e5e7eb; font-weight: 600; color: #1f2937;">
          <span>Total Amount:</span>
          <span>₹<%= @order.total_amount %></span>
        </div>
      </div>
    </div>

    <!-- Next Steps -->
    <div style="margin-bottom: 30px;">
      <h3 style="color: #1f2937; font-size: 18px; font-weight: 600; margin: 0 0 15px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        What's Next?
      </h3>
      <div style="color: #4b5563; font-size: 16px; line-height: 1.6; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        <ul style="margin: 0; padding-left: 20px;">
          <li style="margin-bottom: 8px;">Complete your payment to activate your order</li>
          <li style="margin-bottom: 8px;">You'll receive a payment confirmation email once payment is successful</li>
          <li style="margin-bottom: 8px;">Access your products immediately after payment confirmation</li>
          <li style="margin-bottom: 8px;">Contact support if you need any assistance</li>
        </ul>
      </div>
    </div>

    <!-- CTA Button -->
    <div style="text-align: center; margin-bottom: 30px;">
      <a href="<%= order_url(@order) %>" style="display: inline-block; background-color: #059669; color: #ffffff; text-decoration: none; padding: 15px 30px; border-radius: 8px; font-weight: 600; font-size: 16px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; transition: background-color 0.3s;">
        View Order Details
      </a>
    </div>

    <!-- Support Information -->
    <div style="background-color: #f3f4f6; border-radius: 8px; padding: 20px; text-align: center;">
      <h4 style="color: #1f2937; font-size: 16px; font-weight: 600; margin: 0 0 10px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        Need Help?
      </h4>
      <p style="color: #6b7280; font-size: 14px; margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        If you have any questions about your order, please don't hesitate to contact our support team.
      </p>
      <p style="color: #6b7280; font-size: 14px; margin: 5px 0 0 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
        Email: <a href="mailto:support@pisoftsolutions.in" style="color: #059669; text-decoration: none;">support@pisoftsolutions.in</a>
      </p>
    </div>

  </div>
</div>

<!-- Footer -->
<div style="background-color: #1f2937; padding: 30px 20px; text-align: center;">
  <div style="max-width: 500px; margin: 0 auto;">
    <p style="color: #9ca3af; font-size: 14px; margin: 0 0 10px 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
      © <%= Date.current.year %> PiSoftSolutions. All rights reserved.
    </p>
    <p style="color: #9ca3af; font-size: 12px; margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
      This email was sent to <%= @order.user_email %> because you placed an order with us.
    </p>
  </div>
</div>
