<!-- Order Status Header -->
<% if @order.payment_successful? %>
  <!-- Success Header -->
  <section class="bg-gradient-to-r from-green-600 to-emerald-600 text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="w-20 h-20 bg-white bg-opacity-20 rounded-full flex items-center justify-center mx-auto mb-6">
          <i class="fas fa-check text-3xl"></i>
        </div>
        <h1 class="text-4xl font-bold mb-4">Order Confirmed!</h1>
        <p class="text-xl opacity-90">Thank you for your purchase</p>
      </div>
    </div>
  </section>
<% elsif @order.payment_failed? %>
  <!-- Failed Header -->
  <section class="bg-gradient-to-r from-red-600 to-red-700 text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="w-20 h-20 bg-white bg-opacity-20 rounded-full flex items-center justify-center mx-auto mb-6">
          <i class="fas fa-times text-3xl"></i>
        </div>
        <h1 class="text-4xl font-bold mb-4">Payment Failed</h1>
        <p class="text-xl opacity-90">Your payment could not be processed</p>
      </div>
    </div>
  </section>
<% else %>
  <!-- Pending Header -->
  <section class="bg-gradient-to-r from-yellow-600 to-orange-600 text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="w-20 h-20 bg-white bg-opacity-20 rounded-full flex items-center justify-center mx-auto mb-6">
          <i class="fas fa-clock text-3xl"></i>
        </div>
        <h1 class="text-4xl font-bold mb-4">Payment Pending</h1>
        <p class="text-xl opacity-90">Please complete your payment to confirm your order</p>
      </div>
    </div>
  </section>
<% end %>

<!-- Order Details -->
<section class="py-12">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-lg shadow-lg p-8">
      <!-- Order Info -->
      <div class="border-b border-gray-200 pb-6 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Order Information</h2>
            <div class="space-y-2">
              <div class="flex justify-between">
                <span class="text-gray-600">Order ID:</span>
                <span class="font-semibold">#<%= @order.id %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Order Date:</span>
                <span class="font-semibold"><%= @order.created_at.strftime("%B %d, %Y") %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Status:</span>
                <span class="px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-sm font-semibold">
                  <%= @order.status.titleize %>
                </span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Payment Status:</span>
                <% if @order.payment_successful? %>
                  <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-semibold">
                    <i class="fas fa-check mr-1"></i>Paid
                  </span>
                <% elsif @order.payment_failed? %>
                  <span class="px-3 py-1 bg-red-100 text-red-800 rounded-full text-sm font-semibold">
                    <i class="fas fa-times mr-1"></i>Failed
                  </span>
                <% else %>
                  <div class="flex flex-col items-end">
                    <span class="px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-sm font-semibold mb-1">
                      <i class="fas fa-clock mr-1"></i>Pending
                    </span>
                    <span class="text-xs text-gray-500">
                      Waiting since <%= time_ago_in_words(@order.created_at) %> ago
                    </span>
                  </div>
                <% end %>
              </div>
              <% if @order.razorpay_payment_id.present? %>
                <div class="flex justify-between">
                  <span class="text-gray-600">Payment ID:</span>
                  <span class="font-semibold text-sm"><%= @order.razorpay_payment_id %></span>
                </div>
              <% end %>
              <div class="flex justify-between">
                <span class="text-gray-600">Email:</span>
                <span class="font-semibold"><%= @order.user_email %></span>
              </div>
            </div>
          </div>
          
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Order Summary</h3>
            <div class="space-y-2">
              <div class="flex justify-between">
                <span class="text-gray-600">Total Items:</span>
                <span class="font-semibold"><%= @order_items.sum(&:quantity) %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Subtotal:</span>
                <span class="font-semibold">₹<%= @order.subtotal %></span>
              </div>
              <% if @order.total_discount > 0 %>
                <div class="flex justify-between">
                  <span class="text-gray-600">Discount:</span>
                  <span class="font-semibold text-green-600">-₹<%= @order.total_discount %></span>
                </div>
              <% end %>
              <div class="flex justify-between">
                <span class="text-gray-600">Tax:</span>
                <span class="font-semibold">₹0.00</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Shipping:</span>
                <span class="font-semibold text-green-600">FREE</span>
              </div>
              <div class="border-t border-gray-200 pt-2 mt-2">
                <div class="flex justify-between">
                  <span class="text-lg font-bold text-gray-900">Total:</span>
                  <span class="text-lg font-bold text-indigo-600">₹<%= @order.final_total %></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Applied Offers -->
      <% if @applied_offers.any? %>
        <div class="mb-8">
          <h3 class="text-xl font-bold text-gray-900 mb-4">Applied Offers</h3>
          <div class="space-y-3">
            <% @applied_offers.each do |offer| %>
              <div class="flex items-center justify-between p-4 bg-green-50 border border-green-200 rounded-lg">
                <div>
                  <h4 class="font-semibold text-green-800"><%= offer.name %></h4>
                  <p class="text-sm text-green-600"><%= offer.description %></p>
                  <p class="text-xs text-green-500">Code: <%= offer.code %></p>
                </div>
                <div class="text-right">
                  <span class="font-bold text-green-800"><%= offer.display_discount %></span>
                  <p class="text-sm text-green-600">-₹<%= offer.calculate_discount(@order.subtotal) %></p>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      
      <!-- Order Items -->
      <div class="mb-8">
        <h3 class="text-xl font-bold text-gray-900 mb-4">Order Items</h3>
        <div class="space-y-4">
          <% @order_items.each do |order_item| %>
            <div class="flex items-center space-x-4 p-4 border border-gray-200 rounded-lg">
              <div class="w-16 h-16 bg-gradient-to-br from-<%= order_item.product.color %>-500 to-<%= order_item.product.color %>-600 rounded-lg flex items-center justify-center">
                <i class="<%= product_icon(order_item.product) %> text-2xl text-white"></i>
              </div>
              
              <div class="flex-1">
                <h4 class="font-semibold text-gray-900"><%= order_item.product.name %></h4>
                <p class="text-sm text-gray-600"><%= order_item.product.description %></p>
                <div class="flex items-center mt-1">
                  <span class="text-sm text-gray-600">Qty: <%= order_item.quantity %></span>
                  <span class="mx-2">•</span>
                  <span class="font-bold text-<%= order_item.product.color %>-600">₹<%= order_item.price %></span>
                  <% 
                    if order_item.validity_type.blank?
                      default_option = order_item.product.default_validity_option || order_item.product.validity_options.first
                      if default_option && default_option.has_discount? %>
                        <span class="text-sm text-gray-500 line-through ml-2">₹<%= default_option.original_price %></span>
                      <% end
                    end %>
                </div>
                <% if order_item.validity_type.present? %>
                  <div class="flex items-center mt-1">
                    <span class="text-xs text-gray-500"><%= order_item.validity_display %></span>
                  </div>
                <% end %>
              </div>
              
              <div class="text-right">
                <span class="font-bold text-gray-900">₹<%= order_item.subtotal %></span>
              </div>
            </div>
          <% end %>
        </div>
      </div>
      
      <!-- Next Steps -->
      <% if @order.payment_successful? %>
        <!-- Success Next Steps -->
        <div class="bg-green-50 border border-green-200 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-green-900 mb-4">What's Next?</h3>
          <div class="space-y-3">
            <div class="flex items-start">
              <div class="w-6 h-6 bg-green-600 text-white rounded-full flex items-center justify-center text-sm font-bold mr-3 mt-0.5">1</div>
              <div>
                <h4 class="font-semibold text-green-900">Order Confirmation Email</h4>
                <p class="text-sm text-green-700">We've sent a confirmation email to <%= @order.user_email %></p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="w-6 h-6 bg-green-600 text-white rounded-full flex items-center justify-center text-sm font-bold mr-3 mt-0.5">2</div>
              <div>
                <h4 class="font-semibold text-green-900">Product Access</h4>
                <p class="text-sm text-green-700">You'll receive access credentials within 24 hours</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="w-6 h-6 bg-green-600 text-white rounded-full flex items-center justify-center text-sm font-bold mr-3 mt-0.5">3</div>
              <div>
                <h4 class="font-semibold text-green-900">Support</h4>
                <p class="text-sm text-green-700">Our support team is available 24/7 to help you get started</p>
              </div>
            </div>
          </div>
        </div>
      <% elsif @order.payment_failed? %>
        <!-- Failed Next Steps -->
        <div class="bg-red-50 border border-red-200 rounded-lg p-6">
          <h3 class="text-lg font-semibold text-red-900 mb-4">What Happened?</h3>
          <div class="space-y-3">
            <div class="flex items-start">
              <div class="w-6 h-6 bg-red-600 text-white rounded-full flex items-center justify-center text-sm font-bold mr-3 mt-0.5">1</div>
              <div>
                <h4 class="font-semibold text-red-900">Payment Failed</h4>
                <p class="text-sm text-red-700">Your payment could not be processed. This could be due to insufficient funds or card issues.</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="w-6 h-6 bg-red-600 text-white rounded-full flex items-center justify-center text-sm font-bold mr-3 mt-0.5">2</div>
              <div>
                <h4 class="font-semibold text-red-900">Try Again</h4>
                <p class="text-sm text-red-700">You can retry the payment or use a different payment method.</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="w-6 h-6 bg-red-600 text-white rounded-full flex items-center justify-center text-sm font-bold mr-3 mt-0.5">3</div>
              <div>
                <h4 class="font-semibold text-red-900">Contact Support</h4>
                <p class="text-sm text-red-700">If you continue to have issues, please contact our support team.</p>
              </div>
            </div>
          </div>
        </div>
      <% else %>
        <!-- Payment Reminder Alert -->
        <% if @order.payment_timeout? %>
          <div class="mb-6 bg-red-50 border-l-4 border-red-400 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <i class="fas fa-exclamation-triangle text-red-400"></i>
              </div>
              <div class="ml-3">
                <p class="text-sm text-red-700">
                  <strong>Payment Overdue:</strong> Your payment is overdue. Please complete payment immediately to avoid order cancellation.
                </p>
              </div>
            </div>
          </div>
        <% else %>
          <div class="mb-6 bg-blue-50 border-l-4 border-blue-400 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <i class="fas fa-info-circle text-blue-400"></i>
              </div>
              <div class="ml-3">
                <p class="text-sm text-blue-700">
                  <strong>Payment Reminder:</strong> Your order will be automatically cancelled if payment is not completed within 15 minutes. 
                  Complete your payment now to secure your items.
                </p>
              </div>
            </div>
          </div>
        <% end %>
        
        <!-- Pending Next Steps -->
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-yellow-900">Complete Your Payment</h3>
            <div class="flex items-center text-yellow-700">
              <i class="fas fa-clock mr-2"></i>
              <span class="text-sm font-medium">Payment Pending</span>
            </div>
          </div>
          
          <div class="space-y-4">
            <div class="flex items-start">
              <div class="w-6 h-6 bg-yellow-600 text-white rounded-full flex items-center justify-center text-sm font-bold mr-3 mt-0.5">1</div>
              <div>
                <h4 class="font-semibold text-yellow-900">Payment Required</h4>
                <p class="text-sm text-yellow-700">Your order is waiting for payment confirmation. Complete payment to secure your items.</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="w-6 h-6 bg-yellow-600 text-white rounded-full flex items-center justify-center text-sm font-bold mr-3 mt-0.5">2</div>
              <div>
                <h4 class="font-semibold text-yellow-900">Secure Payment</h4>
                <p class="text-sm text-yellow-700">Choose from multiple secure payment options including cards, UPI, and net banking.</p>
              </div>
            </div>
            
            <div class="flex items-start">
              <div class="w-6 h-6 bg-yellow-600 text-white rounded-full flex items-center justify-center text-sm font-bold mr-3 mt-0.5">3</div>
              <div>
                <h4 class="font-semibold text-yellow-900">Instant Access</h4>
                <p class="text-sm text-yellow-700">Once payment is successful, you'll receive instant confirmation and access details via email.</p>
              </div>
            </div>
          </div>
          
          <!-- Payment Options Preview -->
          <div class="mt-6 p-4 bg-white rounded-lg border border-yellow-200">
            <h4 class="font-semibold text-gray-900 mb-3">Available Payment Methods:</h4>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
              <div class="flex items-center justify-center p-2 bg-gray-50 rounded border">
                <i class="fas fa-credit-card text-gray-600 mr-2"></i>
                <span class="text-sm text-gray-700">Cards</span>
              </div>
              <div class="flex items-center justify-center p-2 bg-gray-50 rounded border">
                <i class="fas fa-mobile-alt text-gray-600 mr-2"></i>
                <span class="text-sm text-gray-700">UPI</span>
              </div>
              <div class="flex items-center justify-center p-2 bg-gray-50 rounded border">
                <i class="fas fa-university text-gray-600 mr-2"></i>
                <span class="text-sm text-gray-700">Net Banking</span>
              </div>
              <div class="flex items-center justify-center p-2 bg-gray-50 rounded border">
                <i class="fas fa-wallet text-gray-600 mr-2"></i>
                <span class="text-sm text-gray-700">Wallets</span>
              </div>
            </div>
          </div>
        </div>
      <% end %>
      
      <!-- Action Buttons -->
      <div class="mt-8 flex flex-col sm:flex-row gap-4">
        <% if @order.payment_successful? %>
          <!-- Success Actions -->
          <%= link_to products_path, class: "flex-1 bg-indigo-600 hover:bg-indigo-700 text-white py-3 px-6 rounded-lg font-semibold text-center transition duration-300" do %>
            <i class="fas fa-shopping-bag mr-2"></i>Continue Shopping
          <% end %>
          
          <%= link_to contact_path, class: "flex-1 border border-indigo-600 text-indigo-600 hover:bg-indigo-50 py-3 px-6 rounded-lg font-semibold text-center transition duration-300" do %>
            <i class="fas fa-headset mr-2"></i>Contact Support
          <% end %>
        <% elsif @order.payment_failed? %>
          <!-- Failed Actions -->
          <%= link_to payment_path(@order), class: "flex-1 bg-red-600 hover:bg-red-700 text-white py-3 px-6 rounded-lg font-semibold text-center transition duration-300" do %>
            <i class="fas fa-credit-card mr-2"></i>Retry Payment
          <% end %>
          
          <%= link_to contact_path, class: "flex-1 border border-red-600 text-red-600 hover:bg-red-50 py-3 px-6 rounded-lg font-semibold text-center transition duration-300" do %>
            <i class="fas fa-headset mr-2"></i>Contact Support
          <% end %>
        <% else %>
          <!-- Pending Actions -->
          <div class="w-full">
            <!-- Main Payment Button -->
            <div class="bg-white border-2 border-green-200 rounded-xl p-6 shadow-sm">
              <div class="text-center mb-4">
                <h3 class="text-lg font-bold text-gray-900 mb-2">Complete Your Payment</h3>
                <p class="text-gray-600">Secure your order with instant payment</p>
              </div>
              
              <%= link_to payment_path(@order), class: "block w-full bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white py-4 px-8 rounded-xl font-bold text-lg text-center transition-all duration-300 shadow-lg hover:shadow-2xl transform hover:-translate-y-1 hover:scale-105 focus:outline-none focus:ring-4 focus:ring-green-200" do %>
                <div class="flex items-center justify-center">
                  <i class="fas fa-credit-card text-xl mr-3"></i>
                  <div class="text-left">
                    <div class="text-sm opacity-90">Pay Now</div>
                    <div class="text-2xl font-bold">₹<%= @order.final_total %></div>
                  </div>
                </div>
              <% end %>
              
              <div class="mt-4 text-center">
                <div class="flex items-center justify-center text-xs text-gray-500 mb-2">
                  <i class="fas fa-shield-alt mr-1"></i>
                  <span>100% Secure Payment</span>
                </div>
                <div class="flex items-center justify-center space-x-4 text-xs text-gray-400">
                  <span>✓ <%= ENV['DEFAULT_PAYMENT_GATEWAY']&.capitalize %></span>
                  <span>✓ SSL Encrypted</span>
                </div>
              </div>
            </div>
            
            <!-- Secondary Actions -->
            <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3">
              <%= link_to contact_path, class: "flex items-center justify-center py-3 px-6 border-2 border-green-200 text-green-700 hover:bg-green-50 hover:border-green-300 rounded-lg font-semibold text-center transition duration-300" do %>
                <i class="fas fa-headset mr-2"></i>Need Help?
              <% end %>
              
              <%= link_to products_path, class: "flex items-center justify-center py-3 px-6 border-2 border-gray-200 text-gray-600 hover:bg-gray-50 hover:border-gray-300 rounded-lg font-semibold text-center transition duration-300" do %>
                <i class="fas fa-shopping-bag mr-2"></i>Continue Shopping
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
